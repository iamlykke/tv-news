# --- База данных (Supabase → Project Settings → Database → Connection string) ---
# Transaction pooler (порт 6543) — для приложения на Vercel
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler / direct (порт 5432) — для prisma migrate
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# publishable / anon key — нужен браузеру, чтобы залить файл по подписанной ссылке
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# secret / service_role key — только сервер, никогда не светить на клиент
SUPABASE_SERVICE_ROLE_KEY=""
# public bucket, создаётся в Storage
NEXT_PUBLIC_SUPABASE_BUCKET="slides"

# --- Google OAuth (Google Cloud Console → APIs & Services → Credentials) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- NextAuth ---
# openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Почты через запятую: при входе автоматически становятся Full Admin.
# Нужно, чтобы впустить первого админа в пустую базу.
ADMIN_EMAILS="you@gmail.com"

# Подпись на слайде годовщины: "5 years with <ORG_NAME>". Пусто — "5 years with us".
NEXT_PUBLIC_ORG_NAME=""
